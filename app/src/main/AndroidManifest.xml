<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── 네트워크 권한 ──────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ FCM 푸시 알림 표시 권한 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── 위치 권한 (지도 현재 위치 표시용) ──────────────────────────────── -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── 사진 읽기 권한 (공유 앨범 갤러리 그리드용) ──────────────────────────── -->
    <!-- MediaStore를 직접 조회해 원본 사진 URI를 얻으려면 사진 읽기 권한이 필요하다.
         시스템 포토피커는 위치 EXIF를 항상 제거하므로 직접 그리드를 구성한다. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ "선택한 사진만 허용" 부분 접근 대응 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- ── 사진 EXIF 위치 메타데이터 접근 권한 ──────────────────────────────── -->
    <!-- Android 10(API 29)+ 는 갤러리 사진의 GPS EXIF를 기본 차단(redact)함.
         공유 앨범에서 촬영 위치를 핀으로 표시하려면 원본 위치 접근 권한이 필요.
         MediaStore URI + MediaStore.setRequireOriginal()과 함께 사용해야 동작한다. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <application
        android:name=".SyncTripApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher1_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Synctrip">

        <!-- ── Google Maps API 키 ─────────────────────────────────────────── -->
        <!-- 값은 local.properties의 GOOGLE_MAPS_API_KEY에서 secrets 플러그인이 주입 -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <!-- ── 카카오 Native App Key ──────────────────────────────────────── -->
        <!-- 카카오 SDK 초기화에 필요. KakaoSdk.init()에서도 BuildConfig.KAKAO_NATIVE_KEY 사용 -->
        <meta-data
            android:name="com.kakao.sdk.AppKey"
            android:value="${KAKAO_NATIVE_KEY}" />

        <!-- ── 카카오 로그인 – OAuth 리다이렉트 처리 Activity ──────────────── -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- scheme: "kakao" + Native App Key -->
                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_KEY}" />
            </intent-filter>
        </activity>

        <!-- ── FCM 백그라운드 알림 기본 채널 — Firebase가 직접 표시할 때 사용 ──── -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="synctrip_notifications" />
        <!-- 백그라운드 알림 상태바 아이콘 — 지정 안 하면 컬러 런처 아이콘이 흰 사각형으로 깨져 보임 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

        <!-- ── FCM 푸시 알림 서비스 ──────────────────────────────────────────── -->
        <service
            android:name=".SyncTripFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── 메인 Activity ──────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Synctrip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 딥링크: synctrip://band/join?code=XXXXXXXX -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="synctrip" android:host="band" />
            </intent-filter>
            <!-- 웹 링크: https://test.sync-trip.app/invite?code=XXXXXXXX -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="test.sync-trip.app" android:pathPrefix="/invite" />
            </intent-filter>
        </activity>

    </application>

</manifest>
